{
  "expo": {
    "name": "Aahaas CORE",
    "slug": "aahaas-ops",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aahaas",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6FA",
    "ios": {
      "bundleIdentifier": "com.aahaas.ops",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aahaas CORE uses your location while a trip day is running to count the kilometres you drive and show operations where the car is.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Keep counting your kilometres when the phone is locked or another app (like Maps) is open. Tracking runs only between Start day and End day.",
        "NSCameraUsageDescription": "Take photos of your vehicle for the 2-monthly vehicle check.",
        "NSPhotoLibraryUsageDescription": "Choose vehicle or profile photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aahaas.ops",
      "adaptiveIcon": {
        "backgroundColor": "#062476",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Keep counting your kilometres when the phone is locked or another app (like Maps) is open. Tracking runs only between Start day and End day.",
          "locationWhenInUsePermission": "Aahaas CORE uses your location while a trip day is running to count the kilometres you drive.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF2638"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of your vehicle for the 2-monthly vehicle check.",
          "photosPermission": "Choose vehicle or profile photos.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://ops.aahaas.com",
      "opsPhone": "+94707224229",
      "appStage": "Test",
      "router": {},
      "eas": {
        "projectId": "e10e61cf-e111-4c99-ac84-b5558af10734"
      }
    },
    "owner": "sasiofficial25"
  }
}
