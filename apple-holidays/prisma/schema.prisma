generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  password            String               @db.Text
  role                UserRole
  phone               String?
  avatar              String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  country             OperationCountry     @default(ALL)
  countries           String?              @db.Text
  activityLogs        ActivityLog[]
  clientBookings      Booking[]            @relation("ClientUser")
  bookingsCreated     Booking[]            @relation("CreatedBy")
  changeRequests      ChangeRequest[]      @relation("RaisedBy")
  contactLogs         ContactLog[]
  creditAgentPayments CreditAgentPayment[] @relation("CreditPaymentProcessor")
  feedbackSaved       CustomerFeedback[]   @relation("FeedbackSavedBy")
  driverPayments      DriverPayment[]      @relation("ProcessedByUser")
  payments            Payment[]            @relation("ProcessedBy")
  reminders           Reminder[]
  statusEvents        StatusEvent[]

  @@map("users")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model MailMessage {
  id               String            @id @default(cuid())
  graphId          String            @unique
  mailboxUser      String
  mailboxKind      MailboxKind
  uid              Int?
  subject          String
  fromAddress      String
  fromName         String
  toRecipients     Json?
  ccRecipients     Json?
  receivedAt       DateTime
  folder           String
  isRead           Boolean           @default(false)
  hasAttachments   Boolean           @default(false)
  importance       String            @default("normal")
  conversationId   String?
  type             String
  rawBody          String            @db.LongText
  bodyHtml         String            @db.LongText
  bookingRef       String?
  status           MailMessageStatus @default(RECEIVED)
  processedAt      DateTime?
  lastSyncedAt     DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdAt        DateTime          @default(now())
  operationCountry OperationCountry?

  @@index([mailboxUser, receivedAt])
  @@index([mailboxUser, status])
  @@index([bookingRef])
  @@map("mail_messages")
}

model Booking {
  id                     String                    @id @default(cuid())
  bookingRef             String                    @unique
  agentBookingId         String?
  agent                  String?
  fileHandler            String?
  version                Int                       @default(1)
  amendmentNote          String?                   @db.Text
  status                 BookingStatus             @default(DRAFT)
  arrivalDate            DateTime
  departureDate          DateTime
  paxAdults              Int                       @default(0)
  paxChildren            Int                       @default(0)
  quotedTotal            Decimal?                  @db.Decimal(10, 2)
  currency               String                    @default("USD")
  cancellationDeadline   DateTime?
  terms                  String?                   @db.Text
  exclusions             String?                   @db.Text
  policyNotes            String?                   @db.Text
  sourceDocUrl           String?                   @db.Text
  sourceDocName          String?
  clientPortalUnlockedAt DateTime?
  recheckCompletedAt     DateTime?
  recheckCompletedBy     String?
  createdById            String
  clientUserId           String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  agentEmail             String?
  agentPhone             String?
  agentWhatsapp          String?
  agentCountry           String?
  agentAddress           String?                   @db.Text
  contactEmail           String?
  contactPhone           String?
  contactWhatsapp        String?
  contactCountry         String?
  contactAddress         String?                   @db.Text
  qcAutoEmailSentAt      DateTime?
  qcAutoWaSentAt         DateTime?
  qcPassedAt             DateTime?
  operationCountry       OperationCountry?
  chauffeurContact       String?                   @db.Text
  checkedBy              String?
  dealName               String?
  isNumber               String?
  languagePreference     String?
  reconfirmBy            String?
  specialOccasions       String?                   @db.Text
  tourDestination        String?
  onedriveFolderUrl      String?                   @db.Text
  clientRequest          String?                   @db.Text
  cntlNumber             String?
  importantNotes         String?                   @db.Text
  otherNote              String?                   @db.Text
  packageExcludes        String?                   @db.Text
  packageIncludes        String?                   @db.Text
  tips                   String?                   @db.Text
  valueAddedServices     String?                   @db.Text
  paxInfants             Int                       @default(0)
  cancelledAt            DateTime?
  cancelledById          String?
  cancelledByName        String?
  cancelledByEmail       String?
  cancellationReason     String?                   @db.Text
  // Cancellation fees captured on the request form. `cancellationFees` is a JSON
  // array of { note, amount } lines; `cancellationFeeTotal` is the server-computed sum.
  cancellationFees       Json?
  cancellationFeeTotal   Decimal?                  @db.Decimal(12, 2)
  // Accounts-team approval trail for a cancellation request.
  cancelRequestedAt      DateTime?
  cancelPrevStatus       BookingStatus?
  cancelDecidedAt        DateTime?
  cancelDecidedByName    String?
  cancelDecidedByEmail   String?
  cancelDecisionNote     String?                   @db.Text
  cancelMailSentAt       DateTime?
  // Hotel Only — accommodation and nothing else. An explicit operator decision
  // that waives itinerary, agenda, drivers, tickets, flights, client
  // reconfirmation and QC on this file. See `src/lib/hotel-only.ts`; hotel
  // reconfirmation is deliberately NOT waived.
  hotelOnly              Boolean                   @default(false)
  hotelOnlyAt            DateTime?
  hotelOnlyBy            String?
  hotelOnlyNote          String?                   @db.Text
  accommodations         Accommodation[]
  versions               BookingVersion[]
  clientUser             User?                     @relation("ClientUser", fields: [clientUserId], references: [id])
  createdBy              User                      @relation("CreatedBy", fields: [createdById], references: [id])
  changeRequests         ChangeRequest[]
  contactLogs            ContactLog[]
  customerFeedback       CustomerFeedback?
  guestFeedback          GuestFeedbackForm?
  emergencyContacts      EmergencyContact[]
  externalPnlLink        ExternalPnlLink?
  flights                Flight[]
  itineraryItems         ItineraryItem[]
  passengers             Passenger[]
  payments               Payment[]
  pnl                    PNL?
  statusEvents           StatusEvent[]
  tickets                Ticket[]
  tourAgenda             TourAgenda?
  slDriverAllocation     SriLankaDriverAllocation?
  driverLog              DriverLog?

  @@index([status])
  @@index([arrivalDate])
  @@index([hotelOnly])
  @@index([clientUserId], map: "bookings_clientUserId_fkey")
  @@index([createdById], map: "bookings_createdById_fkey")
  @@map("bookings")
}

model Passenger {
  id             String        @id @default(cuid())
  bookingId      String
  name           String
  type           PassengerType @default(ADULT)
  age            Int?
  isLead         Boolean       @default(false)
  passport       String?
  nationality    String?
  contact        String?
  mealPreference String?
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "passengers_bookingId_fkey")
  @@map("passengers")
}

model EmergencyContact {
  id        String  @id @default(cuid())
  bookingId String
  name      String
  phone     String?
  role      String?
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "emergency_contacts_bookingId_fkey")
  @@map("emergency_contacts")
}

model Flight {
  id        String   @id @default(cuid())
  bookingId String
  flightNo  String
  date      DateTime
  fromApt   String
  depTime   String
  toApt     String
  arrTime   String
  airline   String?
  notes     String?
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "flights_bookingId_fkey")
  @@map("flights")
}

model Accommodation {
  id             String   @id @default(cuid())
  bookingId      String
  city           String
  hotel          String
  checkIn        DateTime
  checkOut       DateTime
  address        String?  @db.Text
  contact        String?
  nights         Int
  roomType       String?
  mealType       String?
  ownArrangement Boolean  @default(false)
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "accommodations_bookingId_fkey")
  @@map("accommodations")
}

model ItineraryItem {
  id          String   @id @default(cuid())
  bookingId   String
  dayNo       Int
  date        DateTime
  title       String   @db.Text
  description String?  @db.Text
  inclusions  String?  @db.Text
  exclusions  String?  @db.Text
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "itinerary_items_bookingId_fkey")
  @@map("itinerary_items")
}

model TourAgenda {
  id        String       @id @default(cuid())
  bookingId String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     AgendaItem[]
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tour_agendas")
}

model AgendaItem {
  id          String      @id @default(cuid())
  agendaId    String
  date        DateTime
  location    String      @db.Text
  fromPoint   String?     @db.Text
  toPoint     String?     @db.Text
  details     String?     @db.Text
  mealPlan    String?
  meetingTime String?
  serviceType ServiceType @default(OWN_ARRANGEMENT)
  sortOrder   Int         @default(0)
  timeFrom    String?
  timeTo      String?
  /// Free / at-leisure day — no driver or vehicle is required for this movement.
  /// NULL means "never decided": rows saved before this column existed fall back
  /// to text detection (see src/lib/leisure-day.ts). true/false are explicit.
  isLeisure   Boolean?
  /// Hotel-only movement — the guest arranges their own transport (or the file
  /// is accommodation only), so no driver or vehicle is required. Distinct from
  /// `isLeisure`: a leisure day is a free day, a hotel-only day may still be a
  /// full day out that we simply do not drive. Both mean "no driver needed", so
  /// the file counts as allocated. NULL / false = a driver IS required.
  isHotelOnly Boolean?
  agenda      TourAgenda  @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  assignment  Assignment?
  tickets     Ticket[]

  @@index([agendaId], map: "agenda_items_agendaId_fkey")
  @@map("agenda_items")
}

model Assignment {
  id           String         @id @default(cuid())
  agendaItemId String         @unique
  driverName   String?
  driverPhone  String?
  vehicleType  String?
  vehiclePlate String?
  notes        String?        @db.Text
  assignedAt   DateTime       @default(now())
  driverId     String?
  vendorId     String?
  vendorName   String?
  driverRate   Decimal?       @db.Decimal(10, 2)
  rateCurrency String?        @default("USD")
  waSentAt     DateTime?
  /// Tour guide on this movement. `guideId` points at a registered Guide;
  /// the denormalised name/phone also cover ad-hoc guides typed straight into
  /// the movement chart (those are still saved to `guides` on first use, so the
  /// second booking can pick them from the list).
  guideId         String?
  guideName       String?
  guidePhone      String?
  /// Local tour vendor / supplier handling this movement — same registered vs
  /// ad-hoc rule as the guide above.
  tourVendorId    String?
  tourVendorName  String?
  tourVendorPhone String?
  agendaItem   AgendaItem     @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  driver       Driver?        @relation(fields: [driverId], references: [id])
  vendor       VehicleVendor? @relation(fields: [vendorId], references: [id])
  guide        Guide?         @relation(fields: [guideId], references: [id])
  tourVendor   TourVendor?    @relation(fields: [tourVendorId], references: [id])

  @@index([driverId], map: "assignments_driverId_fkey")
  @@index([vendorId], map: "assignments_vendorId_fkey")
  @@index([guideId], map: "assignments_guideId_fkey")
  @@index([tourVendorId], map: "assignments_tourVendorId_fkey")
  @@map("assignments")
}

model Ticket {
  id            String       @id @default(cuid())
  bookingId     String
  agendaItemId  String?
  pnlLineId     String?
  type          String
  qty           Int          @default(1)
  supplier      String?
  costPerUnit   Decimal?     @db.Decimal(10, 2)
  totalCost     Decimal?     @db.Decimal(10, 2)
  currency      String       @default("USD")
  status        TicketStatus @default(DRAFT)
  purchasedAt   DateTime?
  reference     String?
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fileName      String?
  fileType      String?
  fileUrl       String?      @db.Text
  activated     Boolean      @default(true)
  category      String?
  transferType  String?
  vehicleType   String?
  vehicleNumber String?
  driverName    String?
  driverPhone   String?
  // Where this ticket was bought. MY/SG/VN buy through resellers (Cebu, Global
  // Tix, Travel Vago, Be My Guest) or from an agent, and Accounts pays whoever
  // that was — Payable 1.0 reads these columns back onto its payable line.
  //
  // portalId points at payment_portals in the Accounts database, which is a
  // different server and so cannot be a relation. portalName is stored beside
  // it deliberately: a ticket has to keep saying where it was bought even if
  // the portal is later renamed or removed from the list.
  portalId      Int?
  portalName    String?
  // The portal's own booking reference for this purchase, when it gives one.
  portalRef     String?
  portalBy      String?
  portalAt      DateTime?
  // The Accounts approval this ticket is waiting on, mirrored.
  //
  // MY/SG/VN tickets are submitted to Accounts *before* they are bought: the
  // portal above says where we intend to buy, and this says how far that
  // request has got. The request itself lives in `ticket_approvals` in the
  // Accounts database (src/lib/ticket-approvals.ts) — these columns are a copy
  // kept so the tickets list can filter and colour by state without a
  // cross-database query per row, and are refreshed from there, never the
  // other way round. NULL approvalStatus = never submitted.
  approvalStatus    String?
  approvalId        Int?
  approvalUrgency   String?
  approvalReason    String?
  approvalNeededBy  DateTime?
  submittedBy       String?
  submittedAt       DateTime?
  approvalDecidedBy String?
  approvalDecidedAt DateTime?
  approvalNote      String?      @db.Text
  approvalPaidAt    DateTime?
  approvalPaidRef   String?
  approvalSyncedAt  DateTime?
  agendaItem    AgendaItem?  @relation(fields: [agendaItemId], references: [id])
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pnlLine       PNLLineItem? @relation(fields: [pnlLineId], references: [id])

  @@index([agendaItemId], map: "tickets_agendaItemId_fkey")
  @@index([bookingId], map: "tickets_bookingId_fkey")
  @@index([pnlLineId], map: "tickets_pnlLineId_fkey")
  @@index([portalName], map: "tickets_portalName_idx")
  @@index([approvalStatus], map: "tickets_approvalStatus_idx")
  @@map("tickets")
}

model PNL {
  id           String        @id @default(cuid())
  bookingId    String        @unique
  paxAdults    Int           @default(0)
  paxChildren  Int           @default(0)
  sourceDocUrl String?       @db.Text
  lockedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isPnlData    Json?
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lineItems    PNLLineItem[]

  @@map("pnl")
}

model PNLLineItem {
  id                 String        @id @default(cuid())
  pnlId              String
  activity           String
  category           PNLCategory   @default(OTHER)
  mmtRate            Decimal       @db.Decimal(10, 2)
  sicRate            Decimal       @default(0.00) @db.Decimal(10, 2)
  pvtRatePP          Decimal       @default(0.00) @db.Decimal(10, 2)
  adEntrance         Decimal       @default(0.00) @db.Decimal(10, 2)
  chEntrance         Decimal       @default(0.00) @db.Decimal(10, 2)
  otherRate          Decimal       @default(0.00) @db.Decimal(10, 2)
  paymentStatus      PaymentStatus @default(PENDING)
  paymentConfirmedAt DateTime?
  paymentConfirmedBy String?
  sortOrder          Int           @default(0)
  notes              String?       @db.Text
  paymentRefNumber   String?
  paymentBillName    String?
  paymentBillUrl     String?
  pnl                PNL           @relation(fields: [pnlId], references: [id], onDelete: Cascade)
  tickets            Ticket[]

  @@index([pnlId], map: "pnl_line_items_pnlId_fkey")
  @@map("pnl_line_items")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  type          String
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  method        String?
  status        PaymentStatus @default(PENDING)
  reference     String?
  notes         String?       @db.Text
  paidAt        DateTime?
  processedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  dueDate       DateTime?
  label         String?
  refNumber     String?
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  processedBy   User?         @relation("ProcessedBy", fields: [processedById], references: [id])

  @@index([bookingId], map: "payments_bookingId_fkey")
  @@index([processedById], map: "payments_processedById_fkey")
  @@map("payments")
}

model ChangeRequest {
  id           String              @id @default(cuid())
  bookingId    String
  raisedById   String
  targetField  String?
  notes        String              @db.Text
  status       ChangeRequestStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedNote String?             @db.Text
  createdAt    DateTime            @default(now())
  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy     User                @relation("RaisedBy", fields: [raisedById], references: [id])

  @@index([bookingId], map: "change_requests_bookingId_fkey")
  @@index([raisedById], map: "change_requests_raisedById_fkey")
  @@map("change_requests")
}

model StatusEvent {
  id        String         @id @default(cuid())
  bookingId String
  fromState BookingStatus?
  toState   BookingStatus
  actorId   String
  note      String?        @db.Text
  createdAt DateTime       @default(now())
  actor     User           @relation(fields: [actorId], references: [id])
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([actorId], map: "status_events_actorId_fkey")
  @@map("status_events")
}

model BookingVersion {
  id            String   @id @default(cuid())
  bookingId     String
  versionNo     Int
  source        String?
  docSnapshot   String?  @db.LongText
  amendmentNote String?  @db.Text
  createdById   String
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, versionNo])
  @@index([bookingId], map: "booking_versions_bookingId_fkey")
  @@map("booking_versions")
}

model ContactLog {
  id          String   @id @default(cuid())
  bookingId   String
  userId      String
  type        String
  subject     String
  notes       String?  @db.Text
  contactedAt DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([bookingId], map: "contact_logs_bookingId_fkey")
  @@index([userId], map: "contact_logs_userId_fkey")
  @@map("contact_logs")
}

model Reminder {
  id          String    @id @default(cuid())
  bookingId   String
  userId      String
  type        String
  title       String
  message     String?   @db.Text
  scheduledAt DateTime
  sentAt      DateTime?
  isDone      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "reminders_userId_fkey")
  @@map("reminders")
}

model Driver {
  id             String                     @id @default(cuid())
  name           String
  phone          String
  email          String?
  licenseNo      String?
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  advanceBalance Decimal                    @default(0.00) @db.Decimal(10, 2)
  bankAccountNo  String?
  bankBranch     String?
  bankCode       String?
  bankHolder     String?
  bankName       String?
  vehicleId      String?                    @unique
  photoUrl       String?                    @db.Text
  country        OperationCountry?
  vendorId       String?
  assignments    Assignment[]
  driverPayments DriverPayment[]
  slAllocations  SriLankaDriverAllocation[]
  vehicle        Vehicle?                   @relation(fields: [vehicleId], references: [id])
  vendorOwner    VehicleVendor?             @relation("VendorDrivers", fields: [vendorId], references: [id])

  @@index([vendorId], map: "drivers_vendorId_fkey")
  @@map("drivers")
}

model Vehicle {
  id           String         @id @default(cuid())
  type         String
  plateNo      String         @unique
  capacity     Int
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  brand        String?
  model        String?
  photoInside  String?        @db.Text
  photoOutside String?        @db.Text
  vendorId     String?
  driver       Driver?
  vendor       VehicleVendor? @relation(fields: [vendorId], references: [id])

  @@index([vendorId], map: "vehicles_vendorId_fkey")
  @@map("vehicles")
}

model VehicleVendor {
  id            String                     @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  isActive      Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  country       OperationCountry?
  isRegistered  Boolean                    @default(false)
  password      String?
  whatsappPhone String?
  bankName      String?
  bankAccountNo String?
  bankHolder    String?
  bankBranch    String?
  bankCode      String?
  assignments   Assignment[]
  drivers       Driver[]                   @relation("VendorDrivers")
  vehicles      Vehicle[]
  slAllocations SriLankaDriverAllocation[]

  @@map("vehicle_vendors")
}

/// Tour guide. Registers through the public link (`/register/guide?country=…`)
/// exactly like a driver does, or is entered by Ground staff. Guides only
/// appear in the movement chart for countries switched on in Settings
/// (`guide_countries` — see src/lib/partner-directory.ts).
model Guide {
  id             String            @id @default(cuid())
  name           String
  country        OperationCountry?
  phone          String
  whatsappPhone  String?
  email          String?
  photoUrl       String?           @db.Text
  nicNo          String?
  languages      String?           @db.Text
  additionalInfo String?           @db.Text
  specialNote    String?           @db.Text
  bankName       String?
  bankAccountNo  String?
  bankHolder     String?
  bankBranch     String?
  bankCode       String?
  /// Self-registrations land inactive and are activated by Ground after review.
  isActive       Boolean           @default(true)
  source         PartnerSource     @default(STAFF)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignments    Assignment[]

  @@index([country], map: "guides_country_idx")
  @@map("guides")
}

/// Local tour vendor / supplier (excursions, activities, sub-contracted tours).
/// Distinct from `VehicleVendor`, which supplies drivers and vehicles only.
model TourVendor {
  id             String            @id @default(cuid())
  name           String
  country        OperationCountry?
  phone          String
  whatsappPhone  String?
  email          String?
  photoUrl       String?           @db.Text
  nicNo          String?
  services       String?           @db.Text
  additionalInfo String?           @db.Text
  specialNote    String?           @db.Text
  bankName       String?
  bankAccountNo  String?
  bankHolder     String?
  bankBranch     String?
  bankCode       String?
  isActive       Boolean           @default(true)
  source         PartnerSource     @default(STAFF)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignments    Assignment[]

  @@index([country], map: "tour_vendors_country_idx")
  @@map("tour_vendors")
}

model DriverPayment {
  id          String            @id @default(cuid())
  driverId    String
  amount      Decimal           @db.Decimal(10, 2)
  type        DriverPaymentType @default(ADVANCE)
  description String?
