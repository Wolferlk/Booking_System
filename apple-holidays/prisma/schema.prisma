// ─────────────────────────────────────────────────────────────────────────────
// Booking Team Query Monitor
//
// Hourly Microsoft Graph sweep of the booking team's file-handler mailboxes.
// Every inbound sales query is deduplicated across handlers, enriched (sales
// person / agent / destination / travel date), stored here as the source of
// truth, and appended to the "Query Entry Sheet" tab of the SharePoint master
// workbook. Nothing in this cluster touches the booking pipeline — it is a
// read-only observer of the mailboxes plus a writer to one spreadsheet.
// ─────────────────────────────────────────────────────────────────────────────

/// A file-handler mailbox that is swept each run. `displayName` is what gets
/// written into the sheet's "File Handler" column (the team uses first names
/// there, e.g. abdul.rahman@aahaas.com → "Abdul"), so it is editable per row.
model QueryMonitorMailbox {
  id            String              @id @default(cuid())
  email         String              @unique
  displayName   String
  /// USER  — a real or shared mailbox, read directly from Graph.
  /// ALIAS — a distribution group with no mailbox of its own (availcheck@).
  ///         Graph cannot open it, so its traffic is attributed from the TO/CC
  ///         headers of the mail collected out of the member inboxes instead.
  mailboxKind   String              @default("USER")
  /// Further addresses that mean the same group, comma-separated — the same
  /// list is written to under two domains. VarChar with a default, not Text:
  /// see the note on `QueryMonitorEntry.toList`.
  aliasAddresses String             @default("") @db.VarChar(500)
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  lastCheckedAt DateTime?
  lastMessageAt DateTime?
  lastError     String?             @db.Text
  totalSeen     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  matches       QueryMonitorMatch[]

  @@map("query_monitor_mailboxes")
}

/// Sender → sales person / agent mapping. Matched by full email first, then by
/// domain, highest `priority` wins. Unmatched external senders still produce a
/// row (sales person "Others") when `query_monitor_capture_unmatched` is on.
model QueryMonitorSenderRule {
  id            String    @id @default(cuid())
  matchType     String    @default("DOMAIN") // DOMAIN | EMAIL
  pattern       String    @unique
  salesPerson   String
  agent         String
  region        String?
  destination   String?
  isActive      Boolean   @default(true)
  priority      Int       @default(0)
  matchCount    Int       @default(0)
  lastMatchedAt DateTime?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([matchType, isActive])
  @@map("query_monitor_sender_rules")
}

/// One row per unique inbound query = one row in the spreadsheet. When the same
/// mail reaches several file handlers it stays a single entry; each recipient is
/// recorded as a QueryMonitorMatch, their names fill the TO List cell, and
/// exactly one of them is chosen as the File Handler who owns the query.
model QueryMonitorEntry {
  id               String              @id @default(cuid())
  dedupKey         String              @unique // internetMessageId, else conversationId+subject hash
  conversationId   String?
  /// Thread identity: Graph's `conversationId` when there is one, else
  /// `subjectKey`. Every later mail of the same thread folds into the first
  /// entry rather than taking a row of its own — one query, one sheet row.
  threadKey        String?             @db.VarChar(190)
  /// Fallback thread identity, for mail Graph gives no conversationId for:
  /// `fromDomain|subject`, with the Re:/Fw: prefixes and spacing stripped.
  /// Only set when the subject carries a 4-digit-or-longer reference, so two
  /// unrelated "Urgent quote required" mails can never collapse into one row.
  subjectKey       String?             @db.VarChar(190)
  /// Set on a follow-up: the entry whose sheet row already stands for this
  /// thread. Such entries are kept (their dedupKey is what stops the mail being
  /// looked at again) but are never written — their sync state is MERGED.
  mergedIntoId     String?
  /// How many later mails of the thread folded into this row.
  ///
  /// Inbound only, and kept for exactly that reason: it is what the merge logic
  /// increments. What the sheet's "Mails in Thread" column now shows is
  /// `inboundCount + outboundCount` — the whole conversation, both ways.
  followUpCount    Int                 @default(0)
  /// This entry re-opened a thread that had already been answered — the agent
  /// wrote back after `repliedAt`, so it is a new question with a clock of its
  /// own rather than a chaser on the old one, and it takes a row of its own.
  ///
  /// The append guard reads it: an entry opening a round is matched only on the
  /// exact row identity (date + allocation time + subject), never on the looser
  /// same-day-same-subject one, which cannot tell two rounds of one thread apart.
  newRound         Boolean             @default(false)
  /// Mails from the agent on this thread, the opening one included. Rolled up
  /// from `events` so a sheet write never has to aggregate them per row.
  inboundCount     Int                 @default(1)
  /// Mails we sent on this thread — replies, forwards and internal notes alike.
  outboundCount    Int                 @default(0)
  /// Who wrote the newest mail of the thread and which way it went, so
  /// "waiting on us" and "waiting on them" can be told apart at a glance.
  lastActor        String?
  lastDirection    String?             @db.VarChar(8)
  /// When the newest mail of the thread arrived. `receivedAt` stays the first
  /// one: the SLA is measured from when the query was originally asked.
  lastMessageAt    DateTime?
  subject          String              @db.Text
  fromAddress      String
  fromName         String
  fromDomain       String
  /// QUERY → the master query sheet. EXCLUDED → the "other mail" tab: vouchers,
  /// on-ground incidents, avail checks and the like, kept out of the SLA pivots.
  mailKind         String              @default("QUERY")
  /// The exclusion pattern that diverted it, written to the second tab's Reason column.
  excludeReason    String?
  receivedAt       DateTime // sheet column D — "Allocation time"
  repliedAt        DateTime? // sheet column E — "Replied time"
  /// Sheet column O — the handler whose Sent Items the reply was found in. Kept
  /// apart from `handlerNames`: the owner of a query and the person who happened
  /// to answer it are usually but not always the same, and the team wants both.
  repliedBy        String?
  /// The address the reply was actually sent from — the identity behind
  /// `repliedBy`, which is only the first name the sheet shows.
  repliedByEmail   String?
  /// Sheet column X — where the reply went. "Replied by Sajid" is half an
  /// answer; this is what shows it went back to the agent who asked rather than
  /// to a colleague.
  repliedToAddress String?             @db.VarChar(500)
  /// Sheet column Y — DIRECT (the agent was answered) | FORWARD (passed to a
  /// colleague, agent not yet answered) | INTERNAL (discussed among ourselves).
  /// Only DIRECT stops the SLA clock. Null while nothing has gone out at all.
  replyType        String?             @db.VarChar(16)
  /// Sheet column Z — "Sajid → Vishmika · Vishmika → Sudari", oldest hop first.
  forwardChain     String?             @db.VarChar(500)
  /// internetMessageId of the sent mail counted as the reply, so an attribution
  /// can be traced back to a real message in someone's Sent Items.
  replyMessageId   String?
  /// How the reply was matched to this query:
  /// RECIPIENT — same thread *and* addressed back to whoever asked (strongest),
  /// CONVERSATION — same thread only (an internal forward looks like this),
  /// SUBJECT — no conversation id; same normalised subject, back to the asker.
  replyMatch       String?
  replyStatus      String              @default("PENDING") // REPLIED | PENDING | OVERDUE
  /// Sheet column F — the ONE handler who owns this query. Empty until it can be
  /// known: filled straight away when the mail reached a single mailbox, on the
  /// first reply with whoever answered, or by hand from the TO-list dropdown.
  handlerNames     String              @db.Text
  /// Sheet column G — every mailbox the mail actually reached, comma-joined.
  /// `handlerNames` is always one of these names.
  ///
  /// VarChar with a default, not Text: MySQL forbids defaults on TEXT, and a
  /// required column with no default cannot be added to a populated table —
  /// Prisma would demand a database reset. A handful of first names never
  /// approaches 500 characters.
  toList           String              @default("") @db.VarChar(500)
  salesPerson      String?
  agent            String?
  destination      String?
  travelDate       DateTime?
  travelDateText   String?
  cntl             String?
  amendment        String?
  region           String?
  isUrgent         Boolean             @default(false)
  bodySnippet      String              @db.Text
  extractionSource String              @default("RULE") // RULE | AI | MANUAL
  aiConfidence     Float?
  /// Sheet column T — one sentence describing what the mail is asking for,
  /// written by gpt-4o-mini when the "AI reads every new mail" switch is on.
  /// Null means it was never summarised, which is the normal state with the
  /// switch off — it is not backfilled over history.
  aiSummary        String?             @db.Text
  aiSummaryAt      DateTime?
  /// Sheet column AA — what happened across the *whole* thread, in one or two
  /// sentences. Distinct from `aiSummary`, which reads the opening mail only and
  /// never moves again: this one is rewritten every time the thread grows, which
  /// is the only way a row standing for eleven mails can say anything true.
  replySummary     String?             @db.Text
  replySummaryAt   DateTime?
  /// How many ledger events the stored summary was written from. Regeneration
  /// happens when this falls behind `inboundCount + outboundCount` — that test
  /// is what stops a sweep paying for a summary of a thread that has not moved.
  replySummaryEvents Int               @default(0)
  /// Sheet column AB — why this row is the one that survived when duplicates
  /// were folded into it: which rule matched, and what it absorbed. Blank on the
  /// overwhelming majority of rows, and that is the point — a filled cell is the
  /// sheet showing its working for a line that now stands for mail nobody can
  /// see written out any more.
  duplicateReason  String?             @db.Text
  /// Field names the user hand-edited — re-extraction and re-sync never clobber these.
  manualOverrides  Json?
  sheetRow         Int?
  /// Which worksheet `sheetRow` refers to — the two tabs number their rows separately.
  sheetTab         String?
  /// PENDING | SYNCED | DIRTY | FAILED | SKIPPED | MERGED.
  /// MERGED is terminal: the mail belongs to a thread another row already
  /// carries, so it is deliberately never appended anywhere.
  syncStatus       String              @default("PENDING")
  syncError        String?             @db.Text
  syncedAt         DateTime?
  /// The standby workbook numbers its rows independently of the primary, so it
  /// carries its own row pointer and its own sync state — a backup that fails to
  /// write must be retried without re-appending to the primary.
  backupSheetRow   Int?
  backupSyncStatus String              @default("PENDING") // PENDING | SYNCED | DIRTY | FAILED | SKIPPED
  backupSyncError  String?             @db.Text
  /// The fill last painted onto this entry's row in each workbook — a replied
  /// query's row is turned green. A cache, not a source of truth: it exists so a
  /// sweep does not re-send the same formatting call for rows already coloured.
  sheetHighlight   String?
  backupHighlight  String?
  firstRunId       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  matches          QueryMonitorMatch[]
  events           QueryMonitorThreadEvent[]

  @@index([receivedAt])
  @@index([syncStatus])
  @@index([replyStatus])
  @@index([conversationId])
  @@index([threadKey])
  @@index([subjectKey])
  @@index([mergedIntoId])
  @@index([fromDomain])
  @@index([mailKind])
  @@index([backupSyncStatus])
  @@map("query_monitor_entries")
}

/// The per-mailbox sighting of an entry. Its existence is what makes "one mail,
/// many file handlers" collapse into a single sheet row instead of duplicates.
model QueryMonitorMatch {
  id          String              @id @default(cuid())
  entryId     String
  mailboxId   String
  graphId     String
  handlerName String
  receivedAt  DateTime
  repliedAt   DateTime?
  folder      String?
  /// True when this recipient was read off the mail's TO/CC line rather than out
  /// of its own inbox — how a distribution group is counted at all.
  viaAlias    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  entry       QueryMonitorEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  mailbox     QueryMonitorMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([entryId, mailboxId])
  @@index([graphId])
  @@index([mailboxId])
  @@map("query_monitor_matches")
}

/// One row per message of a thread, in both directions — the record that lets a
/// single sheet row say what actually happened in a conversation.
///
/// `QueryMonitorMatch` answers "which mailboxes saw this mail". This answers the
/// question the team kept having to open Outlook for: who wrote in, who answered
/// them and when, and who forwarded the thread on to whom. Every roll-up on the
/// entry — `inboundCount`, `outboundCount`, `forwardChain`, `replyType`,
/// `replySummary` — is computed from these rows and stored there only so a sheet
/// write does not have to aggregate per row.
///
/// Recording is idempotent on `eventKey`. Every sweep re-reads an overlapping
/// window of Sent Items on purpose, so the same reply is offered to the ledger
/// again and again and must land exactly once.
model QueryMonitorThreadEvent {
  id           String   @id @default(cuid())
  /// The root entry whose sheet row stands for this thread. Follow-ups keep no
  /// ledger of their own — their mail is an event on the row they merged into.
  entryId      String
  /// `entryId|internetMessageId`, falling back to the Graph id when a message
  /// carries none.
  eventKey     String   @unique @db.VarChar(190)
  /// IN — from the agent to us · OUT — from one of the monitored mailboxes.
  direction    String   @db.VarChar(8)
  /// QUERY (opened the thread) | FOLLOW_UP (a later mail from the agent) |
  /// REPLY (ours, back to whoever asked — the only kind that stops the SLA
  /// clock) | FORWARD (ours, to a colleague) | INTERNAL (ours, to neither).
  kind         String   @db.VarChar(16)
  /// The handler's first name for OUT, the agent's display name for IN.
  actorName    String   @default("")
  actorAddress String   @default("")
  /// Everyone it went to, already resolved to handler names where the address is
  /// one of ours. VarChar with a default for the same reason as `Entry.toList`.
  toNames      String   @default("") @db.VarChar(500)
  toAddresses  String   @default("") @db.VarChar(500)
  occurredAt   DateTime
  subject      String   @default("") @db.VarChar(500)
  snippet      String?  @db.Text
  messageId    String?
  createdAt    DateTime @default(now())
  entry        QueryMonitorEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, occurredAt])
  @@index([direction])
  @@map("query_monitor_thread_events")
}

/// One record per sweep — the "View log" feed. `steps` holds the full ordered
/// trace (mailbox fetches, rule matches, AI calls, sheet writes) as JSON.
model QueryMonitorRun {
  id               String    @id @default(cuid())
  trigger          String    @default("CRON") // CRON | MANUAL | BOOT
  status           String    @default("RUNNING") // RUNNING | SUCCESS | PARTIAL | FAILED | SKIPPED
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  windowFrom       DateTime?
  windowTo         DateTime?
  mailboxesScanned Int       @default(0)
  messagesSeen     Int       @default(0)
  entriesCreated   Int       @default(0)
  entriesUpdated   Int       @default(0)
  repliesDetected  Int       @default(0)
  rowsAppended     Int       @default(0)
  rowsUpdated      Int       @default(0)
  aiCalls          Int       @default(0)
  errors           Int       @default(0)
  errorMessage     String?   @db.Text
  triggeredBy      String?
  steps            String?   @db.LongText

  @@index([startedAt])
  @@index([status])
  @@map("query_monitor_runs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pre-checking / D-10 Hotel Reconfirmation
//
// Every hotel stay on a booking has to be reconfirmed with the property ten
// days before the guest checks in. These four tables are the whole feature and
// are purely additive — no existing table gains or loses a column.
//
// Deliberately FK-free. Accommodations are deleted and re-created wholesale
// whenever a booking is amended, so a cascading FK would silently destroy the
// reconfirmation trail on every amendment. Instead a stay is addressed by its
// `stayKey` (bookingRef + normalised hotel name + check-in date), which
// survives amendments; `accommodationId` is a soft pointer re-resolved on read.
// ─────────────────────────────────────────────────────────────────────────────

/// Where a hotel profile's details originally came from.
enum HotelProfileSource {
  ACCOUNTS // matched against invoice_processor.hotel_details
  MANUAL   // typed in by staff
  AI       // researched via OpenAI web search, then saved
}

/// Kind of contact channel held against a hotel.
enum HotelContactKind {
  PHONE
  MOBILE
  WHATSAPP
  EMAIL
  FAX
}

/// Reconfirmation state of one hotel stay.
enum HotelConfirmStatus {
  PENDING     // nobody has spoken to the hotel yet
  IN_PROGRESS // contacted, waiting on the hotel's reply
  CONFIRMED   // hotel confirmed the booking as stated
  DISCREPANCY // hotel confirmed but something differs (rooms, meal, dates)
  ISSUE       // hotel cannot honour the booking
  CANCELLED   // stay dropped
  NOT_REQUIRED // own arrangement / guest booked it themselves
}

/// Hotel master overlay owned by the booking system.
///
/// The Accounts system's `hotel_details` table is the shared master list and is
/// strictly read-only from here. This table mirrors the identity of a matched
/// hotel (`accountsHotelId`) and layers on the operational contact detail the
/// master list does not carry — WhatsApp, reservation desks, verification.
/// Hotels the master list has never heard of live here alone.
model HotelProfile {
  id               String             @id @default(cuid())
  name             String
  /// Lowercased, punctuation- and noise-word-stripped name. Unique join key.
  normalizedName   String             @unique
  countryCode      String             @default("LK") @db.VarChar(2)
  city             String?
  /// invoice_processor.hotel_details.id when this profile is matched to the
  /// Accounts master list. Null for booking-system-only hotels.
  accountsHotelId  Int?
  accountsHotelName String?
  address          String?            @db.Text
  website          String?
  /// Primary numbers, denormalised from `channels` for fast list rendering.
  phone            String?
  email            String?
  whatsapp         String?
  /// True once a human has confirmed the WhatsApp number actually reaches the
  /// hotel. AI-derived and prefix-guessed numbers start false.
  whatsappVerified Boolean            @default(false)
  googleMapsUrl    String?            @db.Text
  source           HotelProfileSource @default(MANUAL)
  notes            String?            @db.Text
  /// Raw payload of the last AI research run, kept for audit and re-review.
  aiResearch       Json?
  aiResearchedAt   DateTime?
  verifiedAt       DateTime?
  verifiedBy       String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  channels         HotelContactChannel[]

  @@index([name])
  @@index([countryCode])
  @@index([accountsHotelId])
  @@map("hotel_profiles")
}

/// One reachable contact point for a hotel. A property may keep any number of
/// them (front desk, reservations, GM mobile, group email…).
model HotelContactChannel {
  id         String           @id @default(cuid())
  hotelId    String
  kind       HotelContactKind @default(PHONE)
  /// "Reservations", "Front Desk", "GM" — free text.
  label      String?
  /// As entered by staff / returned by AI.
  value      String
  /// E.164 where the value is a number and could be normalised.
  e164       String?
  isPrimary  Boolean          @default(false)
  verified   Boolean          @default(false)
  verifiedAt DateTime?
  verifiedBy String?
  /// Set when the number was inferred (e.g. a mobile prefix implying WhatsApp)
  /// rather than confirmed by a person.
  guessed    Boolean          @default(false)
  notes      String?          @db.Text
  createdBy  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  hotel      HotelProfile     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([e164])
  @@map("hotel_contact_channels")
}

/// The reconfirmation record for one hotel stay on one booking.
///
/// Rows are created lazily — the D-10 queue is derived from `accommodations`
/// on read, and a row only materialises the first time somebody records
/// something about the stay.
model HotelReconfirmation {
  id                  String             @id @default(cuid())
  /// bookingRef + normalised hotel + check-in date. Stable across amendments.
  stayKey             String             @unique
  bookingRef          String
  /// Soft pointer to accommodations.id — re-resolved on every read.
  accommodationId     String?
  hotelProfileId      String?
  /// Hotel name as it appeared on the booking when the row was created.
  hotelName           String
  city                String?

  // ── Stay detail. Defaults are seeded from the booking/accommodation, then
  // become staff-editable because the TC document is frequently incomplete.
  checkIn             DateTime
  checkOut            DateTime
  nights              Int                @default(0)
  roomType            String?
  roomCategory        String?
  roomCount           Int?
  mealType            String?
  adults              Int?
  children            Int?
  /// Child With Bed / Child No Bed.
  cwb                 Int?
  cnb                 Int?
  infants             Int?

  // ── Reconfirmation outcome
  status              HotelConfirmStatus @default(PENDING)
  confirmationNumber  String?
  /// Which channel the hotel was reached on last: WHATSAPP | CALL | EMAIL | PORTAL.
  lastChannel         String?
  attempts            Int                @default(0)
  lastCheckedAt       DateTime?
  lastCheckedBy       String?
  /// Manual override of the automatic D-10 due date.
  dueAtOverride       DateTime?
  followUpAt          DateTime?
  discrepancyNote     String?            @db.Text
  notes               String?            @db.Text

  createdBy           String?
  updatedBy           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  events              HotelReconfirmationEvent[]

  @@index([bookingRef])
  @@index([checkIn])
  @@index([status])
  @@index([hotelProfileId])
  @@map("hotel_reconfirmations")
}

/// Append-only audit trail for a stay's reconfirmation. Never updated, never
/// deleted — it is the evidence of who spoke to which hotel and when.
model HotelReconfirmationEvent {
  id           String              @id @default(cuid())
  reconfirmId  String
  /// created | status_change | checked | contacted | edited | linked | unlinked | ai_research
  action       String
  fromStatus   String?
  toStatus     String?
  channel      String?
  note         String?             @db.Text
  actorName    String?
  actorEmail   String?
  createdAt    DateTime            @default(now())

  reconfirm    HotelReconfirmation @relation(fields: [reconfirmId], references: [id], onDelete: Cascade)

  @@index([reconfirmId])
  @@index([createdAt])
  @@map("hotel_reconfirmation_events")
}

/// Why a booking's **guest** reconfirmation was not completed by its D-10
/// deadline (ten days before arrival). One row per booking: the current
/// explanation, overwritten as it changes, deleted when it no longer holds.
///
/// Not to be confused with `HotelReconfirmation` above, which is the D-10
/// reconfirmation of a hotel *stay* with the property. This one is about the
/// guest: client confirmation, or the TE pre-tour call.
///
/// Deliberately keyed by `bookingRef` with no foreign key. Amendments rewrite a
/// booking's child rows wholesale, and an explanation of why a deadline was
/// missed is evidence — it must not be swept away by a cascade. The rules that
/// decide when a row is owed at all live in `src/lib/reconfirm-delay-shared.ts`.
model BookingReconfirmDelay {
  id         String    @id @default(cuid())
  bookingRef String    @unique
  /// A `ReconfirmDelayReason` code — see `src/lib/reconfirm-delay-shared.ts`.
  reason     String    @db.VarChar(32)
  /// Free text. Mandatory for `OTHER`, optional otherwise.
  note       String?   @db.Text
  /// The D-10 date this explanation was recorded against. Kept so an amendment
  /// that moves the arrival shows up as a reason written for a different
  /// deadline rather than silently carrying over to the new one.
  dueAt      DateTime?
  recordedBy String?
  recordedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([reason])
  @@index([recordedAt])
  @@map("booking_reconfirm_delays")
}

/// Acknowledgement that a **last-minute booking** (sold inside D-4) has been
/// seen by the operation. One row per booking ref; its existence is the whole
/// signal, and the absence of a row is what keeps the header alert shouting.
///
/// Acknowledging is deliberately a **team-wide** act, like the AppleSystem
/// import alert: the point is that *somebody* picked the file up, not that
/// everyone read the popup. Who and when are recorded so the morning meeting can
/// ask.
///
/// `arrivalDate` is a snapshot of the arrival the acknowledgement was made
/// against, not a copy of the booking. An amendment that pulls the guest
/// *forward* is new news — a file acknowledged as "arrives Friday" that becomes
/// "arrives tomorrow" is re-raised rather than silently staying quiet. Moving
/// the arrival later never re-raises.
///
/// Keyed by `bookingRef` with no foreign key, matching
/// `BookingReconfirmDelay`: amendments rewrite a booking's child rows wholesale,
/// and a record of who took responsibility for a late file must not be swept
/// away by a cascade. The rules that decide when a row is owed at all live in
/// `src/lib/last-minute-shared.ts`.
model BookingLastMinuteAck {
  id             String   @id @default(cuid())
  bookingRef     String   @unique
  /// Arrival this acknowledgement was made against — see the note above.
  arrivalDate    DateTime
  /// Whole days from creation to arrival at the time of acknowledgement, kept so
  /// a report can count how late the team's late files actually were without
  /// recomputing against a booking that may since have been amended.
  leadDays       Int
  acknowledgedBy String?
  acknowledgedByEmail String?
  acknowledgedAt DateTime @default(now())
  /// Optional free text — what the desk did about it.
  note           String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([acknowledgedAt])
  @@map("booking_last_minute_acks")
}
