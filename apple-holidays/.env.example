# Database
DATABASE_URL="mysql://root:password@localhost:3306/apple_holidays"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-min-32-chars-long-here"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key-here"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Critical Operations Password
CRITICAL_SERVICES_PASSWORD="change-me"

# Cron (used by Vercel cron / GCP Cloud Scheduler to authenticate /api/cron/* routes)
CRON_SECRET="change-me-cron-secret"
# Separate secret for the customer WhatsApp cron routes
# (/api/cron/customer-daily-briefing, /api/cron/customer-feedback-request)
CRON_SECRET_2="Daily_whatsapp_messages_Customer"

# Customer WhatsApp automation (daily briefing + post-departure feedback invite)
# Local hour (0-23) at which the in-process scheduler fires the daily send
CUSTOMER_MSG_SEND_HOUR="18"
# UTC offset in hours used to compute "local" dates/times (7 = Vietnam, 5.5 not supported — use whole hours)
CUSTOMER_MSG_TZ_OFFSET_HOURS="7"
# Secret for signing public feedback-form links (falls back to NEXTAUTH_SECRET when unset)
FEEDBACK_LINK_SECRET=""

# OneDrive Auto-Booking-Create daily scheduler (node-cron, in-process backend job).
# IANA timezone the configured run time (Admin → OneDrive Bookings, e.g. 04:00) is
# interpreted in. This is what makes "morning 4am" land at 4am local, not 4am UTC.
AUTO_BOOKING_TZ="Asia/Colombo"

# WhatsApp (Meta Graph API; the notify proxy is used as fallback)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_NOTIFY_SECRET=""
