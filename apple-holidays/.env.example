
# Aahaas Flow (n8n-project) — the B2C booking page reads an order's products,
# journey, documents and P&L from it. Same value as OPS_FLOW_SERVICE_KEY on the
# Flow server (24+ chars). Flow accepts it for GET only.
AAHAAS_FLOW_SERVICE_KEY=
# AAHAAS_FLOW_API_URL=https://ai.aahaas.com/v1/aahaas-flow

# Gemini backup — used automatically only when an OpenAI call fails
# (outage / quota / rate limit / network). Leave empty to disable.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# AI_FALLBACK_DISABLED=false
