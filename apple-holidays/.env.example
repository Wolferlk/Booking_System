# Database
DATABASE_URL="mysql://root:password@localhost:3306/apple_holidays"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-min-32-chars-long-here"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key-here"

# App
APP_URL="http://localhost:3000"
# Used for opening Accounts' private settlement receipt from the Booking screen.
ACCOUNTS_APP_URL="https://invoice-processor.aahaas.com"
NODE_ENV="development"

# Critical Operations Password
CRITICAL_SERVICES_PASSWORD="change-me"

# Cron (used by Vercel cron / GCP Cloud Scheduler to authenticate /api/cron/* routes)
CRON_SECRET="change-me-cron-secret"
# Separate secret for the customer WhatsApp cron routes
# (/api/cron/customer-daily-briefing, /api/cron/customer-feedback-request)
CRON_SECRET_2="Daily_whatsapp_messages_Customer"

# Shared secret the accounts system (invoice-processor) presents to
# /api/integrations/*. Today that is the Sri Lanka booking repair: its Booking
# Count Check finds a booking it is costing that we never received, and asks us
# to pull it in from the Apple System or its OneDrive folder. Must match
# OPS_REPAIR_SECRET on the accounts side. Falls back to CRON_SECRET when unset;
# with neither set the endpoint refuses every request.
ACCOUNTS_INTEGRATION_SECRET=""

# Customer WhatsApp automation (daily briefing + post-departure feedback invite)
# Local hour (0-23) at which the in-process scheduler fires the daily send
CUSTOMER_MSG_SEND_HOUR="18"
# UTC offset in hours used to compute "local" dates/times (7 = Vietnam, 5.5 not supported — use whole hours)
CUSTOMER_MSG_TZ_OFFSET_HOURS="7"
# Secret for signing public feedback-form links (falls back to NEXTAUTH_SECRET when unset)
FEEDBACK_LINK_SECRET=""

# OneDrive Auto-Booking-Create daily scheduler (node-cron, in-process backend job).
# IANA timezone the configured run time (Admin → OneDrive Bookings, e.g. 04:00) is
# interpreted in. This is what makes "morning 4am" land at 4am local, not 4am UTC.
AUTO_BOOKING_TZ="Asia/Colombo"

# Currency conversion for the Driver Advance Sheet (exchangerate-api.com v6).
# Get a free key at https://www.exchangerate-api.com/ — powers LKR/VND/MYR/SGD display.
EXCHANGE_RATE_API_KEY=""

# WhatsApp (Meta Graph API; the notify proxy is used as fallback)
# WHATSAPP_PHONE_NUMBER_ID is the number ALL booking messages send FROM. Set it to
# the "Aahaas Operations" number 1270807392778665 (+94 70 722 4229). The token must
# be a system-user token with access to that number's WABA (2077665446131914).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID="1270807392778665"
WHATSAPP_BUSINESS_ACCOUNT_ID="2077665446131914"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_NOTIFY_SECRET=""
# Approved "please reply to us" opener template (delivers outside the 24h window)
# used by the booking page's "Send reply request" button to wake a cold customer
# so the Tour Confirmation can then be sent free-form. {{1}}=first name, {{2}}=ref.
WHATSAPP_BOOKING_OPENER_TEMPLATE="apple_holidays_booking_update"
WHATSAPP_BOOKING_OPENER_TEMPLATE_LANG="en"
# Approved re-engagement template — the global WhatsApp inbox composer (dashboard/whatsapp)
# uses this AUTOMATICALLY whenever the open conversation is outside the 24h window: the
# staff member's typed message is delivered as the template's {{1}} body param instead of
# a free-form text (which Meta would silently reject). Same template n8n-project's
# WHATSAPP_REENGAGE_TEMPLATE already uses for this exact purpose — keep them in sync.
WHATSAPP_REENGAGE_TEMPLATE="aahaas_agent_message"
WHATSAPP_REENGAGE_TEMPLATE_LANG="en"

# Customer trip-portal link automation (src/lib/portal-link-whatsapp.ts). Sends the
# signed /trip/<ref>?t=… link to the guest twice: a welcome the day after the booking
# is created, and a "ready to travel?" reminder 3 days before arrival. Both are
# APPROVED templates, since the guest is usually outside the 24h window.
# Register all three at once: POST /api/whatsapp/templates/bootstrap-portal
# welcome/reminder take {{1}}=first name, {{2}}=booking ref, {{3}}=portal link.
WHATSAPP_PORTAL_WELCOME_TEMPLATE="apple_holidays_trip_portal_welcome"
WHATSAPP_PORTAL_REMINDER_TEMPLATE="apple_holidays_trip_portal_reminder"
# Sent to the fallback numbers when the booking has NO guest/tourist number:
# {{1}}=booking ref, {{2}}=portal link.
WHATSAPP_PORTAL_FORWARD_TEMPLATE="apple_holidays_trip_portal_forward"
WHATSAPP_PORTAL_TEMPLATE_LANG="en"
# Ops numbers that receive the link when the booking carries no guest contact.
WHATSAPP_PORTAL_FALLBACK_NUMBERS="94701972263,94755303411,919585222335"
WHATSAPP_PORTAL_WELCOME_DAYS_AFTER="1"
WHATSAPP_PORTAL_REMINDER_DAYS_BEFORE="3"
# Daily send time for both portal sweeps (node-cron, timezone-aware, boot catch-up).
PORTAL_MSG_TZ="Asia/Colombo"
PORTAL_MSG_SEND_HOUR="10"
PORTAL_MSG_SEND_MINUTE="0"

# Driver assignment automation (src/lib/driver-assignment-whatsapp.ts). Messages the
# driver with the booking details the moment they are allocated to a movement —
# from the Assign Driver dialog and from a whole-chart Save. Sent as an APPROVED
# template, since a driver who has never written to the ops number is outside the
# 24h window where free-form text is silently dropped by Meta.
# Register both at once: POST /api/whatsapp/templates/bootstrap-driver
# Assignment: {{1}}=driver name, {{2}}=booking ref, {{3}}=date/pick-up,
#             {{4}}=route, {{5}}=guest + pax, {{6}}=vehicle.
# The agreed rate is deliberately not sent to the driver.
WHATSAPP_DRIVER_ASSIGN_TEMPLATE="apple_holidays_driver_assignment"
# Cancellation (driver un-assigned or replaced): {{1}}=driver name, {{2}}=booking ref.
WHATSAPP_DRIVER_CANCEL_TEMPLATE="apple_holidays_driver_assignment_cancelled"
WHATSAPP_DRIVER_TEMPLATE_LANG="en"
# Kill switch lives in the DB, not here: SystemSetting
# key='auto_whatsapp_driver_assignment_enabled', value='false' stops all of it.

WHATSAPP_PHONE_NUMBER_ID="1270807392778665"
WHATSAPP_BUSINESS_ACCOUNT_ID="2077665446131914"
# Shared secret for the n8n → booking-system inbound signal. n8n owns the Operations
# number's webhook and POSTs { from, name } to /api/webhooks/whatsapp-inbound-signal
# on every inbound so we can open the customer's 24h window + flush queued Tour
# Confirmations. MUST match n8n's BOOKING_SYSTEM_SIGNAL_SECRET. Blank = no auth check.
WHATSAPP_INBOUND_SIGNAL_SECRET="aahaas-booking-inbound-signal-2026"

# Shared WhatsApp store (read-only). Meta delivers the Operations number's inbound
# webhook to n8n (which we otherwise only interconnect with for CALLS); n8n stores
# every inbound — real text, media, wamid — in tbl_whatsapp_messages in this schema
# on the SAME MySQL server as our own DB. We read it directly and import customer
# replies into our own whatsapp_messages, so the whole WhatsApp inbox works inside
# the booking system. Blank host = sync disabled (signal placeholder fallback used).
WA_SHARED_DB_HOST=""
WA_SHARED_DB_PORT="3306"
WA_SHARED_DB_USER=""
WA_SHARED_DB_PASSWORD=""
WA_SHARED_DB_DATABASE="production_live1"
# Base URL for n8n's /v1/whatsapp/media/... proxy paths stored in media_url.
WA_SHARED_MEDIA_BASE="https://travel-parser-live.aahaas.com"


# ── Public AppleSystem (AS) quotation API ────────────────────────────────────
# Credentials AppleSystem uses on POST /api/public/as/v1/auth/login to create,
# update and auto-cancel bookings. Set BOTH before go-live — with neither set,
# the built-in sample client (as_integration) is used in development only and
# refused in production. Docs: Public_API/Updatecancel-AS-API/
AS_PUBLIC_API_USERNAME="as_integration"
AS_PUBLIC_API_PASSWORD="AppleSystem@2026#Quote"
AS_PUBLIC_API_CLIENT_NAME="AppleSystem Integration"
# HS256 signing key for the issued bearer tokens (falls back to NEXTAUTH_SECRET).
AS_PUBLIC_API_JWT_SECRET=""
# Token lifetime in minutes (default 720 = 12 h).
AS_PUBLIC_API_TOKEN_TTL_MIN="720"
# Optional static key alternative to the bearer flow (header: x-api-key).
AS_PUBLIC_API_KEY=""
# Set to "true" only if the sample credentials must work in production.
AS_PUBLIC_API_ALLOW_SAMPLE=""

# ── AppleSystem quotation client (outbound) — resilience knobs ───────────────
# Every call to applev2.appletechlabs.com is retried on an escalating timeout,
# because the upstream intermittently stalls and a single fixed cap was turning
# those stalls into failed daily imports.
# Base timeout for the first attempt (ms). Later rungs are 1.6x / 2.2x / 2.8x / 3.6x.
AS_TIMEOUT_MS="25000"
# Override the whole ladder explicitly (comma-separated ms) if the defaults don't fit.
AS_TIMEOUT_LADDER_MS=""
# Total wall-clock one call may spend across all attempts. The short default keeps
# interactive searches responsive (~2 attempts on a dead upstream).
AS_RETRY_BUDGET_MS="90000"
# Budget the background confirmations importer uses — long enough for all 5 rungs.
AS_IMPORT_RETRY_BUDGET_MS="300000"

# ── AppleSystem import failure alerts ────────────────────────────────────────
# Who gets emailed when an import run fails (comma-separated; first is the To,
# the rest are CC'd). Staff are additionally alerted in-app on their next login.
AS_ALERT_EMAIL="sasindu@aahaas.com"
AS_ALERT_CC=""
# Repeats of the same failure inside this window are counted, not re-emailed.
AS_ALERT_DEDUP_MS="1800000"

# ── Public File Handler API ──────────────────────────────────────────────────
# Everything the File Handler Portal can do, exposed at /api/public/fh/v1 for
# another application. Docs: Public_API/File_handle_update_API/
#
# Callers normally log in with a real file handler's own email/phone + password
# (no configuration needed). The variables below are only for a *service*
# client — a machine account that acts on behalf of a handler, so the other app
# never stores handler passwords.
FH_PUBLIC_API_USERNAME="fh_integration"
FH_PUBLIC_API_PASSWORD="FileHandler@2026#Portal"
FH_PUBLIC_API_CLIENT_NAME="File Handler Integration"
# Handler a service client acts for when the request sends no X-File-Handler
# header. Email or file handler id.
FH_PUBLIC_API_ACT_AS=""
# Several service clients at once, with per-client scopes:
# [{"username":"app_a","password":"…","name":"App A","scopes":["booking:read","flight:write"],"actAs":"ops@example.com","lockActAs":true}]
FH_PUBLIC_API_CLIENTS=""
# HS256 signing key for the issued bearer tokens (falls back to NEXTAUTH_SECRET).
FH_PUBLIC_API_JWT_SECRET=""
# Token lifetime in minutes (default 720 = 12 h).
FH_PUBLIC_API_TOKEN_TTL_MIN="720"
# Optional static key alternative to the bearer flow (header: x-api-key).
# Requires X-File-Handler on each request, or FH_PUBLIC_API_ACT_AS above.
FH_PUBLIC_API_KEY=""
# Set to "true" only if the sample service credentials must work in production.
FH_PUBLIC_API_ALLOW_SAMPLE=""

# ─────────────────────────────────────────────────────────────────────────────
# Booking Team Query Monitor  (src/lib/query-monitor/*)
#
# Hourly Microsoft Graph sweep of the file-handler mailboxes into the "Query
# Entry Sheet" tab of the SharePoint master workbook. It reuses the existing
# Azure_* app registration — no new credentials — but that app must hold the
# APPLICATION permissions Mail.Read (inbox + sent items of the handler
# mailboxes) and Files.ReadWrite.All / Sites.ReadWrite.All (write the sheet).
#
# Everything else — which mailboxes, which sender domains, the interval, the
# workbook URL and tab, the SLA — is edited from
# /dashboard/admin/query-monitor and stored in the database, not here.
# ─────────────────────────────────────────────────────────────────────────────
# Timezone the sheet's Date / Allocation time / Replied time cells are written
# in. The team reads the sheet in Sri Lanka, so wall-clock time is local.
# Optional shared secret for pinging /api/cron/query-monitor by hand.
# The Vercel cron bearer (CRON_SECRET) is accepted regardless.
QUERY_MONITOR_TZ="Asia/Colombo"
QUERY_MONITOR_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# INTERNAL CHAT — realtime push (optional)
# ─────────────────────────────────────────────────────────────────────────────
# The shared SSE hub both this app and the Accounts app publish to, and both
# browsers subscribe to. See Booking_System/chat-realtime/README.md.
#
# Leave CHAT_REALTIME_URL empty and chat keeps polling exactly as before — this
# is the switch that turns push on, and it can be turned off again just as
# easily. The secret must be IDENTICAL here, in the Accounts .env, and in the
# hub's own environment: all three sign the same tickets and request bodies.
CHAT_REALTIME_URL=""
CHAT_REALTIME_SECRET=""
CHAT_REALTIME_INTERNAL_URL=""
