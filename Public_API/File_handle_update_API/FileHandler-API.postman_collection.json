    {
      "name": "Cancellation",
      "item": [
        {
          "name": "Can this booking be cancelled?",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "console.log(d.booking_ref + ' → cancellable=' + d.cancellable + ' pending=' + d.pending_approval);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/bookings/{{booking_ref}}/cancel",
              "host": ["{{api_base}}"],
              "path": ["bookings", "{{booking_ref}}", "cancel"]
            },
            "description": "Read-only. Use it to enable or grey out a Cancel button before the user presses it."
          }
        },
        {
          "name": "Request cancellation (with fees)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const d = pm.response.json().data;",
                  "pm.test('Now pending approval', () => pm.expect(d.status).to.eql('PENDING_CANCELLATION'));",
                  "console.log('fee_total=' + d.cancellation_fee_total + ' email_sent=' + d.email_sent);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Guest cancelled the trip\",\n  \"fees\": [\n    { \"note\": \"Hotel one-night penalty\", \"amount\": 120 },\n    { \"note\": \"Non-refundable entrance tickets\", \"amount\": 30 }\n  ]\n}"
            },
            "url": {
              "raw": "{{api_base}}/bookings/{{booking_ref}}/cancel",
              "host": ["{{api_base}}"],
              "path": ["bookings", "{{booking_ref}}", "cancel"]
            },
            "description": "**This does not cancel the booking.** Exactly as in the portal, it moves the booking to PENDING_CANCELLATION and emails the accounts team to approve — hence 202 Accepted.\n\n`fees` is optional and its total is always recomputed server-side, never trusted from the caller. A mail failure does not undo the request: watch `email_sent`.\n\nDestructive on live data — do not run against a real booking without approval."
          }
        }
      ]
    },
