          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/bookings/{{booking_ref}}/pdf?format=base64",
              "host": ["{{api_base}}"],
              "path": ["bookings", "{{booking_ref}}", "pdf"],
              "query": [{ "key": "format", "value": "base64" }]
