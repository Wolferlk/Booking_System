        {
          "name": "Email the PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Sent', () => pm.expect(pm.response.json().data.sent).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"{{recipient_email}}\",\n  \"subject\": \"Your updated itinerary\",\n  \"message\": \"Flights are now confirmed — see the attached update.\",\n  \"self\": false\n}"
            },
            "url": {
              "raw": "{{api_base}}/bookings/{{booking_ref}}/pdf/email",
              "host": ["{{api_base}}"],
              "path": ["bookings", "{{booking_ref}}", "pdf", "email"]
            },
            "description": "Sends the PDF as an attachment via Microsoft Graph. Omit `to` (or send \"self\": true) and it goes to the acting handler's own address — the portal's \"Save & Confirm\" behaviour.\n\nThis really sends mail. Point {{recipient_email}} at your own inbox when testing."
          }
        }
      ]
